@using GovernanceCouncil.Core.Models
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<DebateChamber> Logger

@* Presentation only. The parent owns the session, configuration and received events. *@
<div @ref="_root" class="gc-debate @(_focusStage ? "gc-debate-focus" : "gc-debate-desk") @(_showTimeline ? "gc-debate-show-timeline" : "") @(_animateTyping ? "" : "gc-debate-motion-paused")"
     aria-label="Debate workspace">
    <div class="gc-debate-toolbar">
        <div class="gc-debate-layouts" role="group" aria-label="Debate layout">
            <button type="button" aria-pressed="@(!_focusStage)" @onclick="() => _focusStage = false">Live desk</button>
            <button type="button" aria-pressed="@_focusStage" @onclick="() => _focusStage = true">Focus stage</button>
        </div>

        <p class="gc-debate-evidence-legend">📚 Sources · 🛠️ Tool activity</p>
        <div class="gc-debate-session-state" role="status">
            @if (!string.IsNullOrWhiteSpace(Phase))
            {
                <span>@Phase</span>
            }
            @if (Completed)
            {
                <strong>Complete</strong>
            }
            @if (MaxRounds > 0)
            {
                <span>Round @Round of @MaxRounds</span>
            }
            else if (Round > 0)
            {
                <span>Round @Round</span>
            }
        </div>
        <div class="gc-debate-tools">
            @if (DossierMarkdown is not null)
            {
                <button type="button" id="@DossierButtonId" aria-controls="@InspectorId"
                        aria-expanded="@(_inspector == InspectorKind.Dossier)" @onclick="OpenDossier">Dossier</button>
            }
            @if (Completed && !string.IsNullOrWhiteSpace(AssessmentHref))
            {
                <a class="gc-debate-assessment" href="@AssessmentHref">View Assessment <span aria-hidden="true">↗</span></a>
            }
        </div>
    </div>

    <section class="gc-debate-moderator" aria-label="Current moderator announcement">
        <div class="gc-debate-moderator-label">
            <strong>@ModeratorLabel</strong>
            @if (ModeratorCalling)
            {
                <span class="gc-debate-live">Calling for hands</span>
            }
        </div>
        <div class="gc-debate-announcement" tabindex="0" role="status" aria-live="polite" aria-atomic="true">
            @(string.IsNullOrWhiteSpace(ModeratorAnnouncement) ? "No moderator announcement received in this view." : ModeratorAnnouncement)
        </div>
        <span class="gc-debate-sr-only" role="status" aria-live="polite">@LatestEventLabel</span>
        <button type="button" class="gc-debate-mobile-timeline" aria-controls="@TimelineId" aria-expanded="@_showTimeline"
                aria-label="@TimelineToggleLabel" @onclick="ToggleTimeline">
            @(_showTimeline ? "Back to chat" : $"Timeline ({ModeratorEvents.Count})")
        </button>
    </section>

    @if (ConnectionInterrupted || !string.IsNullOrWhiteSpace(Error) || !string.IsNullOrWhiteSpace(ConclusionReason) || _interopUnavailable)
    {
        <div class="gc-debate-notices" tabindex="0" aria-label="Debate notices">
            @if (ConnectionInterrupted)
            {
                <p class="gc-debate-warning" role="status">Connection interrupted. This view may be behind; received responses remain available below.</p>
            }
            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <p class="gc-debate-danger" role="alert"><strong>Deliberation failed.</strong> @Error <a href="/dossiers">Back to dossiers</a></p>
            }
            @if (!string.IsNullOrWhiteSpace(ConclusionReason))
            {
                <p role="status"><strong>Debate concluded.</strong> @ConclusionReason</p>
            }
            @if (_interopUnavailable)
            {
                <p role="status">Automatic scrolling is unavailable. Use the chat and timeline scrollbars to read the received content.</p>
            }
        </div>
    }

    <div class="gc-debate-workspace">
        <aside class="gc-debate-council" aria-label="Council members and initial positions">
            <div class="gc-debate-panel-heading">
                <h2>Initial positions <span class="gc-debate-count">@Seats.Count(s => !s.IsChair)</span></h2>
                <span class="gc-debate-muted">Initial positions · select a member for full details</span>
            </div>
            <div class="gc-debate-roster" tabindex="0" aria-label="Council roster">
                @foreach (var seat in Seats.Where(s => !s.IsChair))
                {
                    <button @key="seat.Key" type="button" id="@MemberButtonId(seat.Key)"
                            class="gc-debate-member @(seat.Speaking || seat.MicLive ? "gc-debate-on-floor" : "")"
                            aria-label="@($"Inspect {seat.DisplayName}: {SeatStatus(seat)}. {(seat.HandRaised ? HandReason(seat) : "Initial position and details")}")"
                            title="@(seat.HandRaised ? HandReason(seat) : $"Read {seat.DisplayName}'s initial position")"
                            aria-controls="@InspectorId" aria-expanded="@(_inspector == InspectorKind.Member && _memberKey == seat.Key)"
                            @onclick="() => OpenMember(seat.Key, MemberButtonId(seat.Key))">
                        <span class="gc-debate-avatar-wrap">
                            <span class="gc-debate-avatar" style="background-color:@seat.Colour" aria-hidden="true">@AvatarInner(seat.Avatar, seat.Initials)</span>
                            @if (seat.HandRaised)
                            {
                                <span class="gc-debate-avatar-hand" aria-hidden="true">✋</span>
                                <span class="gc-debate-hand-tooltip" role="tooltip">@HandReason(seat)</span>
                            }
                        </span>
                        <span class="gc-debate-member-copy">
                            <strong>@seat.DisplayName</strong>
                            <span>@seat.Role</span>
                            <span class="gc-debate-member-state @(seat.HandRaised || seat.Speaking || seat.MicLive ? "gc-debate-live" : "")">@SeatStatus(seat)</span>
                            @if (!string.IsNullOrWhiteSpace(seat.PositionSummary))
                            {
                                <span class="gc-debate-position-summary">@ModelText.StripSourceAnnotations(seat.PositionSummary)</span>
                            }
                            @if (seat.Assessing && !seat.Blocked && !ConnectionInterrupted)
                            {
                                <span class="gc-debate-typing" aria-label="@($"{seat.DisplayName} is forming an initial position")"><span></span><span></span><span></span></span>
                            }
                        </span>
                    </button>
                }
                @if (Seats.Count == 0)
                {
                    <p class="gc-debate-empty-note">No council members received.</p>
                }
            </div>
        </aside>

        <section class="gc-debate-center" aria-label="Reading workspace">
            <div class="gc-debate-response-panel" hidden="@(_inspector != InspectorKind.None)">
                <div class="gc-debate-reading-state">
                    <span role="status" aria-live="polite">@ReadingStatus</span>
                    <button type="button" class="gc-debate-return" aria-pressed="@_animateTyping" @onclick="() => _animateTyping = !_animateTyping">@(_animateTyping ? "Pause animation" : "Resume animation")</button>
                    <button type="button" class="gc-debate-return" disabled="@(Transcript.Count == 0)" @onclick="ReturnToLive">
                        @(_followingLive ? "Latest messages ↓" : "Return to live")
                        @if (_newResponseIds.Count > 0)
                        {
                            <span class="gc-debate-new-count">@_newResponseIds.Count new</span>
                        }
                    </button>
                </div>
                <div id="@ResponseScrollId" class="gc-debate-response-scroll @(_animateTyping ? "" : "gc-debate-motion-paused")" data-debate-response-scroll tabindex="0" aria-label="Council chat">
                    <div class="gc-debate-chat" data-debate-response-content>
                        @foreach (var turn in Transcript)
                        {
                            <article @key="turn.Id" class="gc-debate-response" style="@($"--speaker-colour:{turn.Colour}")" aria-label="@($"Message from {turn.DisplayName}")">
                                <span class="gc-debate-avatar gc-debate-chat-avatar" style="background-color:@turn.Colour" aria-hidden="true">@AvatarInner(turn.Avatar, turn.Initials)</span>
                                <div class="gc-debate-message">
                                <header class="gc-debate-speaker">
                                    <div>
                                        <h2>@turn.DisplayName</h2>
                                        <p>@turn.Role</p>
                                        <span class="@(turn.Speaking ? "gc-debate-live" : "gc-debate-muted")">@TurnStatus(turn)</span>
                                    </div>
                                </header>
                                <div class="gc-debate-response-text">
                                    @if (turn.IsSynthesis)
                                    {
                                        @if (turn.Blocked)
                                        {
                                            <p class="gc-debate-warning">The Chair's synthesis was blocked by the content-safety policy.</p>
                                        }
                                        else if (Completed)
                                        {
                                            <h3>The Chair has delivered the Assessment.</h3>
                                            @if (string.IsNullOrWhiteSpace(AssessmentHref))
                                            {
                                                <p class="gc-debate-muted">No Assessment link has been received in this view.</p>
                                            }
                                        }
                                        else
                                        {
                                            <p>The Chair is finalising the Assessment…</p>
                                        }
                                        @if (Completed && !string.IsNullOrWhiteSpace(AssessmentHref))
                                        {
                                            <a class="gc-debate-assessment" href="@AssessmentHref">@(turn.Blocked ? "View Assessment details" : "View Assessment") <span aria-hidden="true">↗</span></a>
                                        }
                                    }
                                    else if (turn.IsNexus)
                                    {
                                        @if (turn.Blocked)
                                        {
                                            <p class="gc-debate-warning">This contribution was blocked by the content-safety policy.</p>
                                        }
                                        else if (turn.NexusCount is null)
                                        {
                                            <p>@turn.DisplayName is connecting this assessment to prior decisions…</p>
                                        }
                                        else if (turn.NexusCount == 0)
                                        {
                                            <p>@turn.DisplayName found no connections to prior decisions.</p>
                                        }
                                        else
                                        {
                                            <p>@turn.DisplayName found @turn.NexusCount connection@(turn.NexusCount == 1 ? "" : "s") to prior decisions.</p>
                                        }
                                    }
                                    else if (turn.Blocked)
                                    {
                                        <p class="gc-debate-warning">This contribution was blocked by the content-safety policy. Its text is not displayed.</p>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(turn.Text))
                                    {
                                        <DebateMarkdown Text="@turn.Text" />
                                    }
                                    else if (turn.Speaking && !ConnectionInterrupted)
                                    {
                                        <span class="gc-debate-typing" role="status" aria-label="@($"{turn.DisplayName} is typing")"><span></span><span></span><span></span></span>
                                        <span class="gc-debate-sr-only">@turn.DisplayName is typing…</span>
                                    }
                                    else
                                    {
                                        <p class="gc-debate-muted">@(ConnectionInterrupted && turn.Speaking ? "Waiting for the connection…" : "No response text recorded.")</p>
                                    }
                                    @if (turn.Citations is { Count: > 0 })
                                    {
                                        <details class="gc-debate-citations" aria-label="Response citations">
                                            <summary>📚 Sources (@turn.Citations.Count)</summary>
                                            <ul>
                                                @foreach (var citation in turn.Citations)
                                                {
                                                    <li>
                                                        @if (IsSafeCitation(citation.Url))
                                                        {
                                                            <a href="@citation.Url" target="_blank" rel="noopener">@citation.Title <span class="gc-debate-sr-only">(opens in a new tab)</span><span aria-hidden="true">↗</span></a>
                                                        }
                                                        else
                                                        {
                                                            <span>@citation.Title</span>
                                                        }
                                                    </li>
                                                }
                                            </ul>
                                        </details>
                                    }
                                    @if (turn.ToolCalls is { Count: > 0 })
                                    {
                                        <details class="gc-debate-tool-calls" aria-label="Response tool activity">
                                            <summary><span aria-hidden="true">🛠️</span> Tools (@turn.ToolCalls.Count)</summary>
                                            @foreach (var toolCall in turn.ToolCalls)
                                            {
                                                <details class="gc-tool-call">
                                                    <summary>
                                                        <span aria-hidden="true">🔧</span>
                                                        <strong>@toolCall.Tool</strong>
                                                        <span class="gc-tool-source">@toolCall.Source</span>
                                                        <span>@toolCall.Summary</span>
                                                    </summary>
                                                    <pre>@toolCall.Json</pre>
                                                </details>
                                            }
                                        </details>
                                    }
                                </div>
                                </div>
                            </article>
                        }
                        @if (Transcript.Count == 0)
                        {
                            <div class="gc-debate-empty">
                                <h2>@(Completed ? "Deliberation complete" : AssessmentMode ? "Initial positions" : "No responses yet")</h2>
                                @if (Completed)
                                {
                                    <p>No responses were recorded in this view. The Assessment, when available, can be opened above.</p>
                                }
                                else if (AssessmentMode)
                                {
                                    <p>Initial positions appear above. Select a member to read the full position.</p>
                                    <p>@Seats.Count(s => !s.IsChair && HasPosition(s)) of @Seats.Count(s => !s.IsChair) initial positions recorded.</p>
                                }
                                else
                                {
                                    <p>Received responses will appear here. You can inspect council members, follow moderator events, or read the dossier while you wait.</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <section id="@InspectorId" class="gc-debate-inspector" hidden="@(_inspector == InspectorKind.None)"
                     aria-labelledby="@InspectorTitleId" @onkeydown="OnInspectorKeyDown">
                <header class="gc-debate-inspector-heading">
                    <h2 id="@InspectorTitleId" tabindex="-1">@InspectorTitle</h2>
                    <button type="button" aria-label="Close inspector and return to chat" @onclick="CloseInspector">Close <span aria-hidden="true">×</span></button>
                </header>
                @if (_inspector == InspectorKind.Dossier)
                {
                    <div class="gc-debate-dossier-format" role="group" aria-label="Dossier format">
                        <button type="button" aria-pressed="@(!_showDossierSource)" @onclick="() => _showDossierSource = false">Rendered</button>
                        <button type="button" aria-pressed="@_showDossierSource" @onclick="() => _showDossierSource = true">Markdown source</button>
                    </div>
                }
                <div class="gc-debate-inspector-scroll" tabindex="0" aria-label="Inspector content" @key="InspectorContentKey">
                    @if (_inspector == InspectorKind.Dossier)
                    {
                        @if (string.IsNullOrWhiteSpace(DossierMarkdown))
                        {
                            <p class="gc-debate-muted">No dossier text was provided.</p>
                        }
                        else if (_showDossierSource)
                        {
                            <pre class="gc-debate-source"><code>@DossierMarkdown</code></pre>
                        }
                        else
                        {
                            <DebateMarkdown Text="@DossierMarkdown" />
                        }
                    }
                    else if (InspectedMember is { } member)
                    {
                        <p class="gc-debate-muted">@member.Role</p>
                        <p class="gc-debate-inspector-status">@SeatStatus(member)</p>
                        @if (member.HandRaised)
                        {
                            <h3>Raised-hand reason</h3>
                            <p class="gc-debate-plain-text">@(string.IsNullOrWhiteSpace(member.HandReason) ? "No reason was received with this hand." : ModelText.StripSourceAnnotations(member.HandReason))</p>
                        }
                        @if (member.Blocked)
                        {
                            <p class="gc-debate-warning">A contribution from this member was blocked by the content-safety policy.</p>
                        }
                        <h3>@(member.IsChair ? "Council role" : "Initial position")</h3>
                        @if (!string.IsNullOrWhiteSpace(member.PositionSummary))
                        {
                            <p>@ModelText.StripSourceAnnotations(member.PositionSummary)</p>
                        }
                        else if (!HasPosition(member))
                        {
                            <p class="gc-debate-muted">@PositionStatus(member)</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(member.Detail))
                        {
                            <h3>Full details</h3>
                            <DebateMarkdown Text="@member.Detail" />
                        }
                        @if (member.ToolCalls is { Count: > 0 })
                        {
                            <h3>🔧 Tool calls</h3>
                            @foreach (var toolCall in member.ToolCalls)
                            {
                                <details class="gc-tool-call">
                                    <summary>
                                        <strong>@toolCall.Tool</strong>
                                        <span class="gc-tool-source">@toolCall.Source</span>
                                        <span>@toolCall.Summary</span>
                                    </summary>
                                    <pre>@toolCall.Json</pre>
                                </details>
                            }
                        }
                    }
                    else if (_inspector == InspectorKind.Member)
                    {
                        <p class="gc-debate-muted">This member is no longer in the received roster.</p>
                    }
                </div>
            </section>
        </section>

        <aside id="@TimelineId" class="gc-debate-timeline" aria-label="Moderator event timeline">
            <header class="gc-debate-timeline-heading">
                <div class="gc-debate-panel-heading"><h2>Moderator timeline</h2><span class="gc-debate-count">@ModeratorEvents.Count</span></div>
                <p>Events received in this view</p>
                <button type="button" disabled="@(ModeratorEvents.Count == 0)" @onclick="ShowLatestEvent">Latest event <span aria-hidden="true">↓</span></button>
            </header>
            <div class="gc-debate-timeline-scroll" data-debate-timeline-scroll tabindex="0" aria-label="Events in received order; timestamps are local">
                <div data-debate-timeline-content>
                    @if (_orderedEvents.Count == 0)
                    {
                        <p class="gc-debate-empty-note">No moderator events received in this view.</p>
                    }
                    else
                    {
                        <ol class="gc-debate-events">
                            @foreach (var entry in _orderedEvents)
                            {
                                <li @key="entry.Sequence" class="gc-debate-event @EventClass(entry.Kind)">
                                    <h3>@entry.Title</h3>
                                    <div class="gc-debate-event-meta">
                                        <span class="gc-debate-event-kind">@EventKindLabel(entry.Kind)</span>
                                        <time datetime="@entry.ReceivedAt.ToString("O")" data-debate-local-time>@entry.ReceivedAt.UtcDateTime.ToString("HH:mm:ss 'UTC'")</time>
                                        <span>@(entry.Round > 0 ? $"Round {entry.Round}" : "Before round 1")</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(entry.Detail))
                                    {
                                        @if (entry.Detail.Length <= 180)
                                        {
                                            <p class="gc-debate-plain-text">@ModelText.StripSourceAnnotations(entry.Detail)</p>
                                        }
                                        else
                                        {
                                            <p>@Preview(ModelText.StripSourceAnnotations(entry.Detail), 140)</p>
                                            <details>
                                                <summary>@(entry.Kind is ModeratorEventKind.HandRaised or ModeratorEventKind.SpeakerSelected ? "Read full reason" : "Read full details")</summary>
                                                <p class="gc-debate-plain-text">@ModelText.StripSourceAnnotations(entry.Detail)</p>
                                            </details>
                                        }
                                    }
                                </li>
                            }
                        </ol>
                    }
                </div>
            </div>
            <p class="gc-debate-timeline-note">Local timestamps. Reloading starts a new view; events missed while disconnected may be absent. This is not a complete audit history.</p>
        </aside>
    </div>

</div>

@code {
    [Parameter] public IReadOnlyList<SeatVm> Seats { get; set; } = Array.Empty<SeatVm>();
    [Parameter] public string? Phase { get; set; }
    [Parameter] public int Round { get; set; }
    [Parameter] public int MaxRounds { get; set; }
    [Parameter] public IReadOnlyList<TurnVm> Transcript { get; set; } = Array.Empty<TurnVm>();
    [Parameter] public string? ConclusionReason { get; set; }
    [Parameter] public bool AssessmentMode { get; set; }
    [Parameter] public bool AssessmentConfirmed { get; set; }
    [Parameter] public bool Completed { get; set; }
    [Parameter] public string? AssessmentHref { get; set; }
    [Parameter] public string DeliberationId { get; set; } = string.Empty;
    [Parameter] public string ModeratorLabel { get; set; } = "Moderator";
    [Parameter] public string? ModeratorAnnouncement { get; set; }
    [Parameter] public bool ModeratorCalling { get; set; }
    [Parameter] public bool ConnectionInterrupted { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? DossierMarkdown { get; set; }
    [Parameter] public string? DossierTitle { get; set; }
    [Parameter] public IReadOnlyList<ModeratorEventVm> ModeratorEvents { get; set; } = Array.Empty<ModeratorEventVm>();

    private enum InspectorKind { None, Member, Dossier }
    private readonly string _instanceId = $"gc-debate-{Guid.NewGuid():N}";
    private readonly HashSet<Guid> _knownTurnIds = new();
    private readonly HashSet<Guid> _newResponseIds = new();
    private readonly CancellationTokenSource _lifetime = new();
    private ElementReference _root;
    private DotNetObjectReference<DebateChamber>? _reference;
    private IReadOnlyList<ModeratorEventVm> _orderedEvents = Array.Empty<ModeratorEventVm>();
    private string? _sessionId;
    private string? _memberKey;
    private string? _inspectorOrigin;
    private string? _pendingFocusId;
    private string? _responseScrollAction;
    private bool _timelineScrollRequested;
    private bool _focusStage;
    private bool _showTimeline;
    private bool _showDossierSource;
    private bool _followingLive = true;
    private bool _animateTyping = true;
    private bool _interopUnavailable;
    private bool _disposed;
    private InspectorKind _inspector;

    private string ResponseScrollId => $"{_instanceId}-response";
    private string InspectorId => $"{_instanceId}-inspector";
    private string InspectorTitleId => $"{_instanceId}-inspector-title";
    private string DossierButtonId => $"{_instanceId}-dossier";
    private string TimelineId => $"{_instanceId}-timeline";
    private string MemberButtonId(string key) => $"{_instanceId}-member-{Uri.EscapeDataString(key)}";
    private string InspectorContentKey => $"{_inspector}:{_memberKey}:{_showDossierSource}";
    private SeatVm? InspectedMember => Seats.FirstOrDefault(s => s.Key == _memberKey);
    private string InspectorTitle => _inspector == InspectorKind.Dossier ? (string.IsNullOrWhiteSpace(DossierTitle) ? "Dossier" : DossierTitle) : InspectedMember?.DisplayName ?? "Member details";
    private string LatestEventLabel => _orderedEvents.Count == 0 ? "No moderator events received." : $"Latest event: {Preview(_orderedEvents[^1].Title, 160)}";
    private string TimelineToggleLabel => $"{(_showTimeline ? "Back to chat" : "Open moderator timeline")}. {ModeratorEvents.Count} events. {LatestEventLabel}";
    private string ReadingStatus => Transcript.Count == 0 ? (Completed ? "No recorded messages" : "Waiting for messages") : _followingLive ? $"Council chat · {Transcript.Count} messages" : $"Reading earlier messages · {_newResponseIds.Count} new";

    protected override void OnParametersSet()
    {
        if (_sessionId != DeliberationId)
        {
            _sessionId = DeliberationId;
            _knownTurnIds.Clear();
            _newResponseIds.Clear();
            _followingLive = true;
            _inspector = InspectorKind.None;
            _memberKey = null;
            _showDossierSource = false;
            _showTimeline = false;
            _responseScrollAction = "bottom";
            _timelineScrollRequested = true;
            // Layout is a reader preference, not session state.
        }

        foreach (var turn in Transcript)
            if (_knownTurnIds.Add(turn.Id) && !_followingLive) _newResponseIds.Add(turn.Id);

        _orderedEvents = ModeratorEvents.OrderBy(e => e.Sequence).ToArray();
    }

    private static bool HasPosition(SeatVm seat) => !string.IsNullOrWhiteSpace(seat.PositionSummary) || !string.IsNullOrWhiteSpace(seat.Detail);

    private string PositionStatus(SeatVm seat) => seat.IsChair
        ? (seat.Blocked ? "Synthesis blocked" : Completed ? "Assessment delivered" : "Prepares the Assessment")
        : seat.InitialPositionUnavailable ? (seat.Blocked ? "Initial position blocked" : "Initial position unavailable")
        : HasPosition(seat) ? "Initial position recorded"
        : seat.Blocked ? "Initial position blocked by the content-safety policy"
        : AssessmentConfirmed && !seat.IsChair ? "No position recorded"
        : seat.Assessing ? "Forming an initial position…" : "No initial position received yet.";

    private string SeatStatus(SeatVm seat) => seat.Speaking ? "Has the floor" : seat.MicLive ? "Microphone live"
        : seat.HandRaised ? "Hand raised" : seat.Assessing ? "Forming a position" : PositionStatus(seat);

    private static string HandReason(SeatVm seat) => string.IsNullOrWhiteSpace(seat.HandReason)
        ? "No reason received." : ModelText.StripSourceAnnotations(seat.HandReason);

    private static string TurnKind(TurnVm turn) => turn.IsSynthesis ? "Assessment" : turn.IsNexus ? "Nexus"
        : turn.IsAssessment ? "Initial position" : "Response";

    private static string TurnStatus(TurnVm turn) => turn.Blocked ? "Content blocked"
        : turn.Speaking ? (turn.IsSynthesis ? "Assessment in progress" : turn.IsNexus ? "Nexus in progress" : "Has the floor") : TurnKind(turn);

    private static string EventKindLabel(ModeratorEventKind kind) => kind switch
    {
        ModeratorEventKind.CallForHands => "Call for hands",
        ModeratorEventKind.HandRaised => "Hand raised",
        ModeratorEventKind.SpeakerSelected => "Speaker selected",
        ModeratorEventKind.Phase => "Phase",
        ModeratorEventKind.Warning => "Warning",
        ModeratorEventKind.Connection => "Connection",
        _ => "Status"
    };

    private static string EventClass(ModeratorEventKind kind) => kind switch
    {
        ModeratorEventKind.CallForHands or ModeratorEventKind.HandRaised => "gc-debate-event-call",
        ModeratorEventKind.SpeakerSelected => "gc-debate-event-selection",
        ModeratorEventKind.Warning or ModeratorEventKind.Connection => "gc-debate-event-warning",
        _ => string.Empty
    };

    private static string Preview(string value, int limit) => value.Length <= limit ? value : value[..limit].TrimEnd() + "…";
    private static bool IsSafeCitation(string? url) => Uri.TryCreate(url, UriKind.Absolute, out var uri) && (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp);

    private void PauseFollowing() => _followingLive = false;

    [JSInvokable]
    public Task PauseResponseFollow() => _disposed ? Task.CompletedTask : InvokeAsync(() =>
    {
        if (!_followingLive) return;
        PauseFollowing();
        StateHasChanged();
    });

    private void ReturnToLive()
    {
        _followingLive = true;
        _newResponseIds.Clear();
        _responseScrollAction = "bottom";
    }

    private void OpenMember(string key, string origin)
    {
        _memberKey = key;
        _inspector = InspectorKind.Member;
        _inspectorOrigin = origin;
        _showTimeline = false;
        _pendingFocusId = InspectorTitleId;
    }

    private void OpenDossier()
    {
        _inspector = InspectorKind.Dossier;
        _inspectorOrigin = DossierButtonId;
        _showTimeline = false;
        _pendingFocusId = InspectorTitleId;
    }

    private void CloseInspector()
    {
        _inspector = InspectorKind.None;
        _pendingFocusId = _inspectorOrigin ?? ResponseScrollId;
    }

    private void OnInspectorKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseInspector();
    }

    private void ToggleTimeline() => _showTimeline = !_showTimeline;
    private void ShowLatestEvent() => _timelineScrollRequested = true;

    private static RenderFragment AvatarInner(string? avatar, string initials) => builder =>
    {
        if (!string.IsNullOrEmpty(avatar))
        {
            builder.OpenElement(0, "img");
            builder.AddAttribute(1, "class", "avatar-img");
            builder.AddAttribute(2, "src", avatar);
            builder.AddAttribute(3, "alt", "");
            builder.AddAttribute(4, "width", "48");
            builder.AddAttribute(5, "height", "48");
            builder.CloseElement();
        }
        else
        {
            builder.AddContent(6, initials);
        }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _interopUnavailable) return;
        _reference ??= DotNetObjectReference.Create(this);
        var options = new
        {
            session = DeliberationId,
            following = _followingLive,
            responseAction = _responseScrollAction,
            timelineToBottom = _timelineScrollRequested,
            focusId = _pendingFocusId,
            fallbackFocusId = ResponseScrollId
        };
        _responseScrollAction = null;
        _timelineScrollRequested = false;
        _pendingFocusId = null;
        try
        {
            await JS.InvokeVoidAsync("debateScroll.sync", _lifetime.Token, _root, _reference, options);
        }
        catch (JSDisconnectedException) { /* The parent owns reconnection. */ }
        catch (OperationCanceledException) when (_disposed) { }
        catch (JSException exception)
        {
            Logger.LogError(exception, "Debate presentation interop failed for {DeliberationId}", DeliberationId);
            _interopUnavailable = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await _lifetime.CancelAsync();
        try
        {
            if (_reference is not null) await JS.InvokeVoidAsync("debateScroll.dispose", _root);
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) when (_disposed) { }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Could not release debate presentation interop for {DeliberationId}", DeliberationId);
        }
        finally
        {
            _reference?.Dispose();
            _lifetime.Dispose();
        }
    }

